# Environment Variables & Credentials
.env
.env.local
.env.*.local

# IDE & Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.project
.settings/

# Datasets & Large Archives (do not commit multi-gigabyte datasets)
dataset/PlantVillage/
dataset/*
!dataset/README.md
!dataset/.gitkeep
*.zip
*.tar.gz
*.rar

# Runtime uploaded user files (preserve directory via .gitkeep)
static/uploads/*
!static/uploads/.gitkeep

# Runtime databases
database/*.db
database/*.sqlite3
!database/.gitkeep

# Test & coverage caches
.pytest_cache/
.coverage
htmlcov/
.tox/

# OS generated files
.DS_Store
Thumbs.db
desktop.ini
